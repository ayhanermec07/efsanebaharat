{
  "name": "efsanebaharat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:test": "node scripts/start-test-server.mjs",
    "test:db:reset": "node scripts/reset-test-database.mjs",
    "test:functions": "node ../supabase/scripts/start-test-functions.mjs",
    "dev:functions": "npx -y supabase@latest functions serve --workdir .. --env-file ../supabase/.env.local",
    "dev:local": "concurrently \"npm run dev:functions\" \"npm run dev\"",
    "build": "node -e \"require('fs').rmSync('node_modules/.vite-temp',{recursive:true,force:true})\" && tsc -b && vite build",
    "build:prod": "node -e \"require('fs').rmSync('node_modules/.vite-temp',{recursive:true,force:true})\" && tsc -b && vite build --mode production",
    "lint": "eslint .",
    "test:preflight": "node --test tests/preflight.test.mjs",
    "test:environment": "node scripts/verify-test-environment.mjs",
    "test:e2e:guest": "node scripts/verify-test-environment.mjs && playwright test tests/e2e/guest-store.spec.ts",
    "test:e2e:auth": "node scripts/verify-test-environment.mjs && playwright test tests/e2e/authenticated.spec.ts",
    "test:e2e:transaction": "node scripts/verify-test-environment.mjs && playwright test tests/e2e/transaction-local.spec.ts",
    "test:e2e:admin-operations": "node scripts/verify-test-environment.mjs && playwright test tests/e2e/admin-operations.spec.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.79.0",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.364.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "react-router-dom": "^7.18.4",
    "recharts": "2.13.0",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "10.4.20",
    "eslint": "^9.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.12.0",
    "postcss": "^8.5.28",
    "tailwindcss": "v3.4.16",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.15.0",
    "vite": "^6.0.1",
    "vite-plugin-source-identifier": "1.1.2"
  }
}
